# ------------------------------------------------------------------
# 智诊通 · 环境变量模板
#
# 用法：cp .env.example .env  然后填入真实值。
# .env 已被 .gitignore 屏蔽，真实密钥永不入库（docs/08 §3 红线）。
#
# 重要：**不填 LLM_API_KEY 也能完整演示主链路** ——
# Supervisor 会自动切换到本地规则路由，评审本地起项目不会白屏。
# ------------------------------------------------------------------

# ========== 大模型（唯一必须项，可留空） ==========
# 留空 → 整条链路走规则路由（Supervisor 规则路由 + 关键词科室表 + 规则打分）
# 填了 → Supervisor / Triage / Reviewer 三个 Agent 都会真调模型
#
# 怎么确认现在是哪种模式：打开 http://localhost:5173/api/health
#   {"mode":"rule-routing"}  → 没接模型
#   {"mode":"llm", "llm":{"provider":"deepseek","model":"deepseek-chat"}}
#                            → 接了，且会告诉你用的哪家哪个模型
LLM_API_KEY=

# 供应商：deepseek | openai | qwen | moonshot | ollama
# 默认 deepseek（中文医疗场景性价比最高，且有免费额度）
#
# 全部走 OpenAI 兼容协议，所以这五家共用一套代码，换家只改这一行。
# 本地 Ollama 不需要 Key：把 LLM_API_KEY 填成任意非空值（如 ollama）即可，
# LLM_BASE_URL 会自动取 http://localhost:11434/v1。
LLM_PROVIDER=deepseek

# 模型名。留空则按 provider 取默认值
# deepseek → deepseek-chat
# openai   → gpt-4o-mini
# qwen     → qwen-plus
# moonshot → moonshot-v1-8k
# ollama   → qwen2.5:7b
LLM_MODEL=

# 自定义网关（走代理或本地 Ollama 时填，留空用官方地址）
LLM_BASE_URL=

# ========== 检索（RAG 阶段才需要） ==========
# pgvector 连接串；省赛阶段可留空，知识库为空时 Retrieval 返回低证据提示
PGVECTOR_URL=postgresql://zhidao:zhidao@localhost:5432/zhidao

# 嵌入模型：bge-m3（1024 维，中文效果好）| text-embedding-3-small
EMBEDDING_MODEL=bge-m3

# ========== 业务后端（Spring Boot） ==========
# 前端 BFF 转发业务请求用
BACKEND_BASE_URL=http://localhost:8080

# ========== 部署 ==========
# BFF 监听端口（dev 期由 vite.config.ts 接管，此值仅 pnpm start 生效）
PORT=5173

# 生产环境前端源（CORS 用；同源部署可留空）
ALLOW_ORIGIN=

# ========== 隐私红线（不要改） ==========
# 医疗数据相关：以下开关关闭时后端会拒绝启动，防止误配导致原文上云
# 参考 docs/08-风险与合规.md §2
PRIVACY_ENFORCE_LOCAL_ONLY=true

# 日志脱敏：开启后日志里不出现任何用户输入文本
LOG_REDACT_USER_TEXT=true
