{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "skipLibCheck": true,

    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,

    // BFF 侧的生成式 UI 渲染器是 .tsx（server/render/registry.tsx 用
    // renderToString 产出 HTML），所以 Node 侧也需要 JSX 转换。
    // 用 react-jsx 自动运行时，不需要 import React。
    "jsx": "react-jsx",

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,

    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["./src/*"],
      "@server/*": ["./server/*"]
    }
  },
  "include": ["server", "vite.config.ts", "src/types"]
}
