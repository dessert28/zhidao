# ------------------------------------------------------------------
# 智诊通 · 后端环境变量模板（Spring Boot 3）
#
# 用法：
#   cp env.example env.local     # 改成你自己的值（env.local 已被 .gitignore 屏蔽）
#   source env.local             # Windows 用 Git Bash / WSL，PowerShell 见文末
#   mvn spring-boot:run
#
# 为什么是 shell export 而不是 .env 文件：
#   Spring Boot 的原生方式是从**进程环境变量**读取 ${VAR:默认值}。
#   它不会自动加载 .env，所以这里给的是可直接 source 的脚本形式，
#   不引入 spring-dotenv 之类的额外依赖 —— 少一个依赖，少一个失败点。
#
# 全部变量都有内置默认值，**一项不配也能启动**（H2 内存库 + 演示 JWT）。
# 下面用注释给的是"改了以后会变成什么"，不是必填项。
# ------------------------------------------------------------------

# ========== 数据源 ==========

# 默认（不设）：H2 内存库，后端进程停掉数据即消失，下次启动重新灌种子。
# 适合：省赛评审现场演示 —— 每次都是干净的初始状态。
# H2_URL=jdbc:h2:mem:zhidao;MODE=MySQL;DB_CLOSE_DELAY=-1;DATABASE_TO_LOWER=TRUE

# 文件库：数据落盘到 backend/data/，重启不丢。
# 适合：连着演示两天、或想保留患者自己造的测试数据。
# 注意：切成文件库时**必须同时**设 APP_SEED_MODE=never，
#       否则每次启动都会再灌一遍种子，出现重复的科室与号源。
# export H2_URL="jdbc:h2:file:./data/zhidao;MODE=MySQL;DATABASE_TO_LOWER=TRUE"
# export APP_SEED_MODE=never

# 启动时是否执行 data.sql 灌种子数据：always | never
# always 是默认值，与内存库配套；一旦改成文件库或 MySQL，就该改 never。
# export APP_SEED_MODE=never

# ========== 安全 ==========

# JWT 签名密钥。
# 默认值写在 application.yml 里且**是公开的**，只能用于本地演示。
# 任何对外可访问的部署都必须换成一串足够长的随机值（≥32 字符）。
# 生成方式：openssl rand -base64 48
# export ZHIDAO_JWT_SECRET="请替换为随机值"

# ========== MySQL（仅 --spring.profiles.active=mysql 时生效）==========
# 对应 docker-compose.yml 里的 mysql 服务。不启 MySQL 就不用管这一段。
# 生产环境请同时加 prod profile：
#   mvn spring-boot:run -Dspring-boot.run.profiles=mysql,prod
# export MYSQL_HOST=localhost
# export MYSQL_PORT=3306
# export MYSQL_DB=zhidao
# export MYSQL_USER=zhidao
# export MYSQL_PASSWORD=zhidao

# ========== 不需要配的项 ==========
# 服务端口固定 8080（application.yml 里写死，未暴露为变量）。
# 若确实要改：mvn spring-boot:run -Dspring-boot.run.arguments=--server.port=9090
#
# ------------------------------------------------------------------
# PowerShell 下没有 source，等价写法：
#   $env:H2_URL="jdbc:h2:file:./data/zhidao;MODE=MySQL;DATABASE_TO_LOWER=TRUE"
#   $env:APP_SEED_MODE="never"
# ------------------------------------------------------------------
