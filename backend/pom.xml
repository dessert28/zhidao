<?xml version="1.0" encoding="UTF-8"?>
<!--
  智诊通 · 业务层（Spring Boot 3.2 + JDK 17）

  这个模块的双重身份：
    比赛：业务闭环的落点 —— 预约单、提醒任务、跨院适配器
    课设：完整的三层架构 CRUD + 定时任务 + 事务 + 参数校验

  边界（docs/04 §1，docs/00；大作业分支 homework/spring-ai-adapter 局部调整）：
    主业务边界不变：患者档案 / 就诊记录 / 预约单、提醒引擎、院区适配
    依然全部在 Spring Boot，AI 主编排仍留在 frontend 侧（Node BFF）。

    课设考核点名 Spring AI Alibaba，故本分支新增**一层薄的 AI 接入**：
      ai/ 包下只做"最小模型调用验证"，不承载五 Agent / RAG / SSE 编排。
    两个约束必须守住：
      ① 无 Key 也能启动、也能跑 —— 模型未配置时端点返回明确状态而非报错，
         与 frontend/server/llm/client.ts 的"没有 Key 就是没有异常"同构
      ② Key 只从环境变量读，不写进 yml 默认值、不进日志
    详细取舍见 docs/17-大作业思路与决策.md
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.2.5</version>
    <relativePath/>
  </parent>

  <groupId>com.zhidao</groupId>
  <artifactId>zhidao-backend</artifactId>
  <version>0.1.0</version>
  <name>zhidao-backend</name>
  <description>智诊通业务层：就诊闭环、提醒引擎、院区适配</description>

  <properties>
    <java.version>17</java.version>
    <mybatis-plus.version>3.5.6</mybatis-plus.version>
    <knife4j.version>4.5.0</knife4j.version>
    <jjwt.version>0.12.5</jjwt.version>

    <!--
      Spring AI 基线：Alibaba starter 1.0.0-M5.1 依赖 Spring AI 1.0.0-M5。
      为什么是 M5 而不是更新的 M6：
        · M6.1 的 autoconfigure 显式依赖 Spring Boot 3.3.3，本项目是 3.2.5
        · M3/M4 的 jar 没进中央仓库（只在 repo.spring.io/milestone），
          而本项目用的是阿里云镜像，拉不到
        · M5 的 jar 已进中央仓库，且 autoconfigure 未锁死 Boot 版本，
          经 dependency:tree 验证可在本项目解析
      OpenAI starter 与 Alibaba starter 同为 M5，混用不会版本打架：
      Alibaba 满足课设条款，OpenAI 兼容协议对接项目现有的 DeepSeek/Qwen 端点。
    -->
    <spring-ai.version>1.0.0-M5</spring-ai.version>
    <spring-ai-alibaba.version>1.0.0-M5.1</spring-ai-alibaba.version>

    <!--
      强制 UTF-8。
      不写这三行的后果（在这台机器上真实踩到，且只在测试里暴露）：
        1. 中文 Windows 的 JVM 默认 file.encoding=GBK
        2. maven-resources-plugin 拷 data.sql 到 target/classes 时按平台编码读，
           UTF-8 的中文字节被当 GBK 解成乱码再写回去 —— 文件"没报错"，内容是坏的
        3. maven-compiler-plugin 编译时源码里的中文字面量同样按 GBK 解，
           提示语全变问号，且编译器一声不吭
      症状是"代码看着没问题，跑出来中文全是乱码"，比编译报错难查得多。
      project.build.sourceEncoding 管编译与资源，file.encoding 管运行时。
    -->
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>

    <!--
      Actuator：健康探针。
      版本交给 parent 管，不写 version —— 和 Spring Boot 版本错配的表现是
      启动时 NoSuchMethodError，而不是编译失败，很难查。

      **optional 而不是 test scope**：它必须打进可运行的 jar（运维要探活），
      但又不是业务代码的硬依赖 —— 代码里不 import 任何 actuator 的类，
      去掉它业务照常启动，只是少一个 /actuator/health。
      这就是"可选依赖，缺失时不能崩"的落地方式：靠不引用，不靠条件装配。
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
      <optional>true</optional>
    </dependency>

    <!-- MyBatis-Plus：省赛用 H2 跑起来，国赛切 MySQL 只改配置 -->
    <dependency>
      <groupId>com.baomidou</groupId>
      <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
      <version>${mybatis-plus.version}</version>
    </dependency>
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>com.mysql</groupId>
      <artifactId>mysql-connector-j</artifactId>
      <scope>runtime</scope>
      <optional>true</optional>
    </dependency>

    <!-- JWT -->
    <dependency>
      <groupId>io.jsonwebtoken</groupId>
      <artifactId>jjwt-api</artifactId>
      <version>${jjwt.version}</version>
    </dependency>
    <dependency>
      <groupId>io.jsonwebtoken</groupId>
      <artifactId>jjwt-impl</artifactId>
      <version>${jjwt.version}</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>io.jsonwebtoken</groupId>
      <artifactId>jjwt-jackson</artifactId>
      <version>${jjwt.version}</version>
      <scope>runtime</scope>
    </dependency>

    <!-- Knife4j：接口文档，答辩时能直接演示 -->
    <dependency>
      <groupId>com.github.xiaoymin</groupId>
      <artifactId>knife4j-openapi3-jakarta-spring-boot-starter</artifactId>
      <version>${knife4j.version}</version>
    </dependency>

    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <optional>true</optional>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>

    <!--
      课设要求的 AI 接入层（仅 annotation + 最小验证端点，不做业务编排）。
      Alibaba starter 对应"考核内容点名 Spring AI Alibaba"这一条；
      OpenAI starter 让同一个 ChatClient 能走项目现有的 OpenAI 兼容端点
      （DeepSeek / Qwen / Ollama），Key 来源与 frontend/.env 一致。
      两者同属 Spring AI 1.0.0-M5 基线，不会版本冲突。
    -->
    <dependency>
      <groupId>com.alibaba.cloud.ai</groupId>
      <artifactId>spring-ai-alibaba-starter</artifactId>
      <version>${spring-ai-alibaba.version}</version>
    </dependency>
    <dependency>
      <groupId>org.springframework.ai</groupId>
      <artifactId>spring-ai-openai-spring-boot-starter</artifactId>
      <version>${spring-ai.version}</version>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!--
        运行时也锁 UTF-8。
        只设 project.build.sourceEncoding 只解决"编译/拷资源"，
        fork 出去的 JVM 仍然读 file.encoding=GBK，读 UTF-8 文件时会二次损坏。
        两个都要设，缺一不可。

        surefire 管 test，spring-boot-maven-plugin 的 jvmArguments 管 spring-boot:run，
        后者尤其重要：评委和答辩现场跑的就是这一条命令。
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <argLine>-Dfile.encoding=UTF-8</argLine>
        </configuration>
      </plugin>

      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <jvmArguments>-Dfile.encoding=UTF-8</jvmArguments>
          <excludes>
            <exclude>
              <groupId>org.projectlombok</groupId>
              <artifactId>lombok</artifactId>
            </exclude>
          </excludes>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
