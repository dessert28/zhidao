  "cards": [
    {
      "dot": "rose",
      "title": "隐私边界",
      "items": [
        "病历原文只存浏览器 IndexedDB，服务端连存原文的列都没有",
        "进模型的是遮蔽后的文本：「患者，男，61 岁」而不是姓名",
        "语音输入与播报均由浏览器原生完成，不经第三方"
      ]
    },
    {
      "dot": "amber",
      "title": "安全与降级",
      "items": [
        "红线 5 类急症用确定性正则，命中即短路，根本不调模型",
        "每个 Agent 由 safeRun 包裹，异常转 failed 不穿透到 SSE",
        "无 LLM_API_KEY 时全链路自动走规则路由，评审本地不白屏"
      ]
    },
    {
      "dot": "emerald",
      "title": "三个差异化",
      "items": [
        "跨院统一时间轴：数据在患者手里，不需医院授权",
        "提醒引擎：每条提醒都带「为什么提醒你」的 reason",
        "只提示不判断：用药冲突说「请让医生确认能否同服」"
      ]
    }
  ]
