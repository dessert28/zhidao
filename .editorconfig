# ------------------------------------------------------------------
# 智诊通 · 编辑器统一约定
#
# 存在的理由：这个项目 Windows / macOS 都有人写。
# 不设这条，Windows 端默认 CRLF，git 每次都显示"整个文件都改了"，
# 评审翻 diff 时看到的全是噪音，反而看不清真实改动。
#
# .gitattributes 负责仓库侧的归一，这里负责编辑器侧的归一，两个都要有。
# ------------------------------------------------------------------
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Java 后端沿用 4 空格缩进（与 Maven 默认、主流 Java 规范一致）
[*.java]
indent_size = 4

[*.md]
# Markdown 里行尾两个空格是硬换行，不能被裁掉
trim_trailing_whitespace = false

[*.{yml,yaml}]
indent_size = 2

[Makefile]
indent_style = tab
