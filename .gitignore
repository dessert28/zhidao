# 依赖与构建产物
node_modules/
*.log
*.err
# `dist*/` 同时覆盖 dist/ 和部署前备份的 dist.pre-<日期>/（旧构建产物不入库）
dist*/
build/
.next/
out/
target/
*.class
*.jar
*.war

# 包管理：只保留 pnpm 的锁文件（docs/10 D8）
package-lock.json
yarn.lock

# 环境变量（真实配置永不入库）
.env
.env.local
.env.*.local
*.env
# 后端环境变量的真实值副本（模板 backend/env.example 可以入库）
env.local

# IDE 与系统
.idea/
.vscode/
*.iml
.DS_Store
Thumbs.db
desktop.ini

# 临时文件
tmp/
temp/
*.tmp
*.bak
*.tsbuildinfo
.tmp-vitest/

# Archify 中间校验产物（保留 .html 与 candidate.json）
.archify/**/run*/
.archify/**/*.finalize.json
.archify/**/*.finalize-summary.json
.archify/**/*.browser-check.json
.archify/**/*.delivery.json

# 端侧模型缓存（129MB 权重，不入库）
frontend/.cache/

# 测试产物（临时生成的图片/PDF/日志）
lab.png
test-*.pdf
test-*.txt
*.log

# H2 文件库数据（可选模式产生）
backend/data/
__pycache__/

# 本机工作数据（AI 助手记忆等，不入库）
.workbuddy/

# 幻灯片工具中间产物与本机临时文件
.slidep/
_tmp_*

# 文档生成流水线的中间产物（含 node_modules，不入库）
output/

# 录制稿（分镜脚本、翻页口播稿）是本地拍摄用的工作材料，不是参赛交付物，不入库
docs/演示视频*.md

# Office 临时锁文件：Word/PPT 打开文档时自动生成 ~$xxx.docx，
# 关掉文档才消失。不忽略的话每次编辑完都会在 git status 里冒出来。
~$*

# 手工另存的旧版备份（曾误留在 docs/ 里的「xxx.彩色旧版备份.docx」）
*.彩色旧版备份.docx

